{
  "name": "dsh-quick-project",
  "version": "0.2.0",
  "description": "DeepSeek Harness bundle plugin: the sidebar's 「+」 becomes one text field — type a project name, the folder is created under ~/project and that Workspace opens. No folder-tree walk.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./name-route": "./host/name-route.mjs"
  },
  "files": [
    "index.mjs",
    "host/name-route.mjs",
    "client/client.js",
    "client/src/client.js",
    "scripts/build.mjs",
    "test/host.test.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "workspace",
    "project"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1",
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
